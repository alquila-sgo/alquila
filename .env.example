# Copiá este archivo como .env (no se sube a GitHub) y completá los valores.
# Los valores reales de producción se cargan en el panel de Cloudflare, nunca en el repo.

# Supabase → Project Settings → API (estas dos son públicas: van al navegador)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (privadas: solo el servidor las usa). Se completan en el paso de fotos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
